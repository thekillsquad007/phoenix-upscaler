/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# Files for AI agents (scripts/build_site_agents.py). Readable from any origin.
/.well-known/*
  Access-Control-Allow-Origin: *

/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"

/.well-known/agent-skills/*
  Cache-Control: public, max-age=3600

# Markdown twins of the pages: for agents, not search results (the HTML is canonical).
/md/*
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *

# App pages: no Cloudflare Web Analytics. Its automatic snippet is injected
# into every HTML page unless the response says no-transform, and these URLs
# can carry secrets: the Motion app takes a wallet key in its fragment
# (#key=pmk_...), /connect carries OAuth parameters in its query.
/motion-app*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/studio-app*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/connect*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
